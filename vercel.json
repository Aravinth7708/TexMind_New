{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start-lovable"
    },
    "nodejs-backend": {
      "root": "nodejs-backend",
      "framework": "express",
      "entrypoint": "src/index.ts"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/chat/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/reindex",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "nodejs-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
